    <statBases>
      <SellPriceFactor>0.5</SellPriceFactor>
    </statBases>
  </ThingDef>
  <ThingDef Name="FashionrimstaApparelMakeableBase" ParentName="FashionrimstaApparelBase" Abstract="True">
